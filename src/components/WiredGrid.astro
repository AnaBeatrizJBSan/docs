---
import { CardGrid } from "@astrojs/starlight/components";
import { loadDataByInfoboxType, loadDataByAnyType } from "@utils/loadData";
import type { WiredInfobox, WiredInfoboxType } from "../content.config";
import { getFurniIcon } from "@utils/furniImages";

type Props =
	| {
			type: WiredInfoboxType;
	  }
	| {
			classname_list: string[];
	  };

let list: WiredInfobox[] | Map<string, WiredInfobox> = [];
if ("type" in Astro.props) {
	const { type } = Astro.props;

	list = await loadDataByInfoboxType(type);
} else if ("classname_list" in Astro.props) {
	const { classname_list } = Astro.props;
	list = new Map();

	const allData = await loadDataByAnyType();

	for (const classname of classname_list) {
		const found = allData.find((infobox) => infobox.classname === classname || ("negative_version" in infobox && infobox.negative_version?.classname === classname));
		
		if (!found) {
			console.error(new Error(`Infobox with classname "${classname}" not found.`))
			continue
		}

		list.set(classname, found);
	}
}

// gerar o plural da rota correta
const typePlural = (type: string) => {
	const folder = ({
		ativador: "ativadores",
		efeito: "efeitos",
		condição: "condicoes",
		condicao: "condicoes",
		extra: "extras",
		seletor: "seletores",
    	"filtro de seletor": "seletores",
		variável: "variaveis",
		"extra de variável": "variaveis",
		contrato: "contratos",
		baú: "outros/baus",
		"tabela de classificação": "outros/tabelas-de-classificacao",
	})[type.toLowerCase()];

	if (!folder) {
		throw new Error(`Unknown infobox type: ${type}`);
	}

	return folder;
}
---

<CardGrid>
	{
		(Array.isArray(list) ? list : Array.from(list.entries())).map((entry) => {
			let infobox = entry;
			if (Array.isArray(infobox)) {
				infobox = infobox[1]; // extrair o infobox do Map
			}
			let classname = infobox.classname;
			let name = infobox.name;
			let description = infobox.description;
			let revision = infobox.revision;
			let iconUrl = getFurniIcon(classname, revision);
			const linkClassname = classname.replace('*', '-');

			if (Array.isArray(entry) && classname !== entry[0]) {
				if ("negative_version" in entry[1] && entry[1].negative_version) {
					classname = entry[1].negative_version.classname;
					name = entry[1].negative_version.name;
					description = entry[1].negative_version.description;
					revision = entry[1].negative_version.revision;
					iconUrl = getFurniIcon(classname, revision);
				} else {
					throw new Error(`Infobox with classname "${entry[0]}" doesn't match.`);
				}
			}

			const negativeIconUrl =
				"type" in Astro.props && "negative_version" in infobox && infobox.negative_version
					? getFurniIcon(
							infobox.negative_version.classname,
							infobox.negative_version.revision,
						)
					: undefined;

			return (
				<a
					href={`/referencia/${typePlural(infobox.type)}/${linkClassname}`}
					class="wired-link-card"
				>
					<div class="card-content">
						<div class="icon-container">
							<img src={iconUrl} alt={name} />
							{negativeIconUrl && !("classname_list" in Astro.props) && (
								<img
									src={negativeIconUrl}
									alt={`${name} (versão negativa)`}
								/>
							)}
						</div>
						<div class="text-content">
							<span class="card-title">{name}</span>
							<p class="card-description">{description}</p>
						</div>
					</div>
				</a>
			);
		})
	}
</CardGrid>

<style>
	.wired-link-card {
		display: flex;
		text-decoration: none;
		background-color: var(--sl-color-bg-nav);
		border: 1px solid var(--sl-color-gray-5);
		border-radius: 0.5rem;
		padding: 1rem;
		transition:
			border-color 0.2s ease,
			background-color 0.2s ease;
		color: var(--sl-color-text);
	}

	.wired-link-card:hover {
		border-color: var(--sl-color-accent);
		background-color: var(--sl-color-bg-accent);
		color: var(--sl-color-text-invert);
	}

	.card-content {
		display: flex;
		align-items: flex-start;
		gap: 1rem;
		width: 100%;
	}
	.icon-container {
		flex: none;
	}
	img {
		width: 30px;
		height: 30px;
		object-fit: contain;
	}

	.text-content {
		display: flex;
		flex-direction: column;
		gap: 0.25rem;
		margin: 0;
	}
	.card-title {
		font-size: var(--sl-text-base);
		font-weight: 600;
	}
	.card-description {
		font-size: var(--sl-text-sm);
		color: var(--sl-color-text-secondary);
	}
</style>
