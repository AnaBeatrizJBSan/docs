---
import { getCollection } from 'astro:content';
import { Icon } from '@astrojs/starlight/components';
import { getRecentlyUpdatedPages } from 'starlight-recent-changes/activity';
import { getFurniIcon } from '../utils/furniImages';

const docs = await getCollection('docs', ({ id, data }) => {
	const badge = data.sidebar?.badge;
	const badgeText = typeof badge === 'string' ? badge : badge?.text;
	return !data.draft && badgeText?.trim().toLowerCase() !== 'rascunho' && id !== 'index' && data.template !== 'splash';
});
const byId = new Map(docs.map((page) => [page.id, page]));
const pages = getRecentlyUpdatedPages(docs).map((update) => ({ ...update, entry: byId.get(update.id)! }));
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const dateFormat = new Intl.DateTimeFormat('pt-BR', { day: 'numeric', month: 'short', year: 'numeric', timeZone: 'America/Sao_Paulo' });
const categories: Record<string, string> = {
	referencia: 'Referência', 'guias-praticos': 'Guia prático', 'vamos-comecar': 'Primeiros passos', 'sobre-nos': 'Comunidade',
};
---

{pages.length > 0 && (
	<section class="recent-pages" aria-labelledby="recent-pages-title">
		<div class="section-heading">
			<div>
				<span class="eyebrow">Explore o que mudou</span>
				<h2 id="recent-pages-title">Novidades na documentação</h2>
			</div>
			<a class="all-changes" href={`${base}/mudancas-recentes/`}>Ver todas as mudanças <Icon name="right-arrow" /></a>
		</div>
		<ul class="recent-grid" role="list">
			{pages.map(({ id, date, kind, entry }) => {
				const infobox = entry.data.infobox;
				const wired = infobox && 'type' in infobox && 'classname' in infobox ? infobox : undefined;
				const category = wired?.type ?? categories[id.split('/')[0]] ?? 'Documentação';
				const description = entry.data.description && entry.data.description !== wired?.classname
					? entry.data.description : 'Conheça os detalhes e as opções de uso nesta página da documentação.';
				return (
					<li>
						<a class="page-card" href={`${base}/${id}/`}>
							<div class="card-top">
								<span class="page-icon" aria-hidden="true">
									{wired && <img src={getFurniIcon(wired.classname, wired.revision)} alt="" width="56" height="56" loading="lazy"
										onerror="this.hidden=true;this.nextElementSibling.hidden=false" />}
									<span hidden={Boolean(wired)}><Icon name={id.startsWith('referencia/') ? 'setting' : 'open-book'} size="30" /></span>
								</span>
								<span class:list={['status', { new: kind === 'add' }]}>{kind === 'add' ? 'Nova página' : 'Atualizada'}</span>
							</div>
							<span class="category">{category}</span>
							<h3 title={entry.data.title}>{entry.data.title}</h3>
							<p class="description">{description}</p>
							<div class="card-bottom">
								<time datetime={date}>{dateFormat.format(new Date(date))}</time>
								<span class="read-page">Explorar <Icon name="right-arrow" size="18" /></span>
							</div>
						</a>
					</li>
				);
			})}
		</ul>
	</section>
)}

<style>
	.recent-pages { margin-block: 1rem 3rem; }
	.section-heading { display: flex; justify-content: space-between; align-items: end; gap: 1rem; margin-bottom: 1.5rem; flex-wrap: wrap; }
	.eyebrow { display: block; color: var(--sl-color-accent); text-transform: uppercase; font-size: .7rem; font-weight: 700; letter-spacing: .12em; margin-bottom: .4rem; }
	h2 { margin: 0; color: var(--sl-color-white); font-size: clamp(1.4rem, 3vw, 1.9rem); line-height: 1.25; }
	.all-changes { display: inline-flex; align-items: center; gap: .4rem; font-size: .8rem; white-space: nowrap; }
	.recent-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 1rem; list-style: none; padding: 0; margin: 0; }
	.recent-grid > li { margin: 0; min-width: 0; }
	.page-card { display: flex; flex-direction: column; height: 100%; padding: 1.25rem; border: 1px solid var(--sl-color-hairline);
		border-radius: var(--wc-radius-lg, .875rem); background: linear-gradient(145deg, var(--sl-color-gray-6), var(--sl-color-bg));
		color: var(--sl-color-text); text-decoration: none; transition: border-color .15s, transform .15s, box-shadow .15s; }
	.page-card:hover { border-color: var(--sl-color-accent); transform: translateY(-3px); box-shadow: var(--wc-shadow); }
	.page-card:focus-visible, .all-changes:focus-visible { outline: 2px solid var(--sl-color-accent); outline-offset: 4px; }
	.card-top { display: flex; align-items: start; justify-content: space-between; gap: .75rem; margin-bottom: 1.1rem; }
	.page-icon { display: grid; place-items: center; width: 4rem; height: 4rem; flex: 0 0 auto; color: var(--sl-color-accent-high);
		border-radius: .75rem; background: var(--sl-color-accent-low); border: 1px solid var(--sl-color-hairline-light); }
	.page-icon img { width: 56px; height: 56px; object-fit: contain; image-rendering: pixelated; }
	.status { padding: .25rem .5rem; border-radius: 99px; font-size: .6rem; font-weight: 600; color: var(--sl-color-accent-high); background: var(--sl-color-accent-low); }
	.status.new { color: var(--sl-color-orange-high); background: var(--sl-color-orange-low); }
	.category { color: var(--sl-color-accent); font-size: .65rem; font-weight: 600; text-transform: uppercase; letter-spacing: .05em; }
	h3 { margin: .4rem 0 .6rem; color: var(--sl-color-white); font-size: 1rem; line-height: 1.5; }
	h3, .description { display: -webkit-box; -webkit-box-orient: vertical; -webkit-line-clamp: 2; overflow: hidden; }
	.description { margin: 0 0 1.25rem; font-size: .8rem; font-weight: 400; line-height: 1.7; }
	.card-bottom { display: flex; align-items: center; justify-content: space-between; gap: .5rem; margin-top: auto;
		padding-top: .9rem; border-top: 1px solid var(--sl-color-hairline); font-size: .65rem; }
	time { color: var(--sl-color-gray-3); }
	.read-page { display: inline-flex; align-items: center; gap: .2rem; font-weight: 600; color: var(--sl-color-text-accent); }
	@media (max-width: 55rem) { .recent-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
	@media (max-width: 36rem) { .recent-grid { grid-template-columns: 1fr; } .section-heading { align-items: start; } }
	@media (prefers-reduced-motion: reduce) { .page-card { transition: none; } .page-card:hover { transform: none; } }
</style>
